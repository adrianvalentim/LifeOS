{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lifeos-tasks",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "MCP_ORIGIN": "https://replace-with-approved-worker-host.invalid",
    "OWNER_GITHUB_ID": "REPLACE_WITH_VERIFIED_OWNER_ID"
  },
  "d1_databases": [{ "binding": "TASKS_DB", "database_name": "lifeos-private-tasks", "database_id": "REPLACE_WITH_APPROVED_DATABASE_ID" }],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_APPROVED_OAUTH_NAMESPACE_ID" }
  ]
}
