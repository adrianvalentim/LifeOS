{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:build": "node scripts/desktop.mjs build",
    "lifeos": "node cli/lifeos.mjs",
    "demo:reset": "node scripts/create-demo-data.mjs --write-active",
    "check": "node scripts/check-syntax.mjs && npm test && npm run desktop:check",
    "test": "node --test",
    "capture:install": "node scripts/install-capture-host.mjs",
    "mcp:tasks": "node scripts/tasks-mcp-server.mjs",
    "mcp:demo:check": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config workers/tasks-demo/wrangler.jsonc",
    "mcp:demo:test": "node --test tests/tasks-worker.test.mjs",
    "tasks:cloud": "node scripts/tasks-cloud.mjs",
    "mcp:private:check": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config workers/tasks/wrangler.jsonc",
    "build:markdown": "node scripts/build-creation-markdown.mjs"
  },
  "bin": {
    "lifeos": "./cli/lifeos.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "dompurify": "3.4.17",
    "jose": "6.2.12",
    "marked": "18.1.1",
    "zod": "4.6.5"
  }
}
